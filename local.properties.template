# Copy this file to local.properties (gitignored) and fill in your values.

# Path to the Android SDK on your machine (Android Studio fills this in automatically).
sdk.dir=/path/to/Android/sdk

# Optional: Strava API credentials for the "Connect Strava" feature.
# Create an app at https://www.strava.com/settings/api to obtain these.
# Authorization Callback Domain must be set to just: strava-callback
# (no scheme/no "://" — Strava validates only the host part of the redirect_uri,
# which is windrm://strava-callback in full)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: map style API keys, used by the "Map style" setting (Settings screen).
# Without these, only OSM Standard and OpenTopoMap are offered (both free, no key needed).
# Mapbox Outdoors: same provider Strava's own app uses. Free token at
# https://account.mapbox.com/access-tokens/ (50k free map loads/month).
# CARTO Positron: free key at https://carto.com/basemaps/apikey/ (5M requests/month, non-commercial)
# Thunderforest Outdoors: free key at https://www.thunderforest.com/pricing/ (150k tiles/month, Hobby tier)
MAPBOX_ACCESS_TOKEN=
CARTO_API_KEY=
THUNDERFOREST_API_KEY=
