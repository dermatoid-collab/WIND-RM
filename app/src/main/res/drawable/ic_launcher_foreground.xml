<?xml version="1.0" encoding="utf-8"?>
<!--
  Sun over a mountain ridge with a road winding towards the viewer, on a white background.
  Drawn in the 398 x 379 coordinates of the reference artwork and scaled into the 72 dp visible
  area of the adaptive icon; the sun stays inside the 66 dp safe zone, while the ridge lines and
  the road run past the edges so every launcher mask crops them as bleeds.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.1809"
        android:scaleY="0.1809"
        android:translateX="18"
        android:translateY="19.72">
        <!-- Sun -->
        <path android:pathData="M176.1,125.4 a82.6,82.6 0 1,0 165.2,0 a82.6,82.6 0 1,0 -165.2,0 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="220" android:startY="50"
                    android:endX="300" android:endY="200"
                    android:startColor="#FE8C18"
                    android:endColor="#F7600C" />
            </aapt:attr>
        </path>
        <!-- White gap between the sun and the ridge -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M100,214 L210,116 L282,188 L305,169 L510,360 L510,520 L100,520 Z" />
        <!-- Ridge: three strokes; the overlapping ends give the notched valleys -->
        <path
            android:pathData="M-110,329.6 L112,144.7 L160,189.7 M155,189.3 L210,140.3 L290,220.3 M283,210 L305,192 L510,364"
            android:strokeWidth="10.5"
            android:strokeLineJoin="miter"
            android:strokeMiterLimit="10"
            android:strokeLineCap="butt">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="0" android:startY="140"
                    android:endX="398" android:endY="270"
                    android:startColor="#FD7E12"
                    android:endColor="#F25A06" />
            </aapt:attr>
        </path>
        <!-- Road -->
        <path android:pathData="M70,237 C140,236 210,240 245,258 C268,271 265,291 248,302 C210,328 150,368 85,400 L-110,507 L-110,395 L-20,364 C40,344 140,312 185,287 C196,280 199,270 192,262 C170,248 120,240 70,237 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="100" android:startY="237"
                    android:endX="150" android:endY="380"
                    android:startColor="#F86A0C"
                    android:endColor="#F44F02" />
            </aapt:attr>
        </path>
    </group>
</vector>
